# Copy to .env (same folder) and fill in. Never commit .env.

# --- API (apps/api) — server only, never exposed to the browser -------------
# Anthropic API key from https://console.anthropic.com/ (Settings → API keys).
# Leave empty to run the planner in labelled Demo mode on sample data.
ANTHROPIC_API_KEY=
# Model for the trip guide (the brief specifies Claude Sonnet 5.5).
PLANNER_MODEL=claude-sonnet-5-5
# Force Demo mode even when a key is set (1 = on). Handy for offline demos.
MITRA_DEMO_MODE=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Plans per minute per client IP before the API answers 429.
PLAN_RATE_PER_MINUTE=8
# Assistant chat messages per minute per client IP.
CHAT_RATE_PER_MINUTE=30
# development enables the debug endpoints (/api/knowledge/search, /api/ingest); set production when deployed.
MITRA_ENV=development

# --- Knowledge assistant (apps/api/rag) --------------------------------------
# Embedding provider: e5 (local multilingual model, default) or hash (tests only).
RAG_EMBEDDINGS=e5
# Days before last_verified counts as stale (static/slow-changing docs, and volatile docs).
RAG_STALE_DAYS=
RAG_STALE_DAYS_VOLATILE=
# Retrieval confidence below which the assistant abstains, and from which it reports "high".
RAG_ABSTAIN_THRESHOLD=0.42
RAG_HIGH_THRESHOLD=0.62
# 1 = include test fixture documents (prompt-injection, stale) in retrieval. Tests only.
RAG_INCLUDE_FIXTURES=
# Live weather for the rain flow: empty (off) or open-meteo (free, no key).
WEATHER_PROVIDER=

# --- Restaurant partners and verification (addendum 5 v3) ---------------------
# demo: every partner submission is sample data, verifications show "(DEMO)", reset is allowed.
# production: sample records never pass the planner filter or show as fully verified.
APP_MODE=demo
# Empty = SQLite in apps/api/data/mitra.db. Deployed: a Postgres URL, e.g. postgresql+psycopg://USER:PASSWORD@HOST/DB
DATABASE_URL=
# Passcode for the partner site's /admin verifier area (sent as X-Admin-Passcode). Choose your own.
ADMIN_PASSCODE=
# Months before a verification expires and the listing drops back to restaurant-reported.
VERIFICATION_EXPIRY_MONTHS=6

# --- Web (apps/web) -----------------------------------------------------------
# Where the FastAPI service is reachable from the browser.
VITE_API_URL=http://localhost:8000
# Scanner OCR engine. Only "tesseract" (on-device, default) is built in.
VITE_OCR_PROVIDER=tesseract
