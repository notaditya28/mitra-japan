{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "vite",
        "apps/web",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "apps/api/.venv/Scripts/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "apps/api",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
